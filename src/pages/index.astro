---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import StatsTicker from '../components/StatsTicker.astro';
import Philosophy from '../components/Philosophy.astro';
import Programs from '../components/Programs.astro';
import Facility from '../components/Facility.astro';
import Trainers from '../components/Trainers.astro';
import Schedule from '../components/Schedule.astro';
import Transformations from '../components/Transformations.astro';
import Calculator from '../components/Calculator.astro';
import Membership from '../components/Membership.astro';
import Location from '../components/Location.astro';
import FAQ from '../components/FAQ.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
import TrialModal from '../components/TrialModal.astro';
import Toast from '../components/Toast.astro';
---

<Layout
  title="IRON FORGE FITNESS // High-Performance Strength & Athletic Compound"
  description="An uncompromising 45,000 sq ft industrial athletic compound. Powerlifting, Hyrox hybrid engine, Olympic barbell mechanics, combat boxing, and cryo thermal recovery. Built under pressure."
>
  <Navbar />
  <main id="main-content">
    <Hero />
    <StatsTicker />
    <Philosophy />
    <Programs />
    <Facility />
    <Trainers />
    <Schedule />
    <Transformations />
    <Calculator />
    <Membership />
    <Location />
    <FAQ />
    <FinalCTA />
  </main>
  <Footer />
  <TrialModal />
  <Toast />
</Layout>
