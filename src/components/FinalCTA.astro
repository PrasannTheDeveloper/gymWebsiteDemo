---
// FinalCTA.astro - High-Impact Closing Command & Instant Pass Claim
---

<section class="section final-cta-section section-border-top" id="final-cta" aria-label="Join Iron Forge">
  <div class="cta-backdrop-texture">
    <img src="/images/hero_athlete.jpg" alt="Iron Forge Athletic Training" class="cta-bg-img" loading="lazy" />
    <div class="cta-backdrop-overlay"></div>
  </div>

  <div class="container cta-container">
    <div class="cta-inner-card cut-corner-tl cut-corner-br">
      <div class="editorial-badge">
        <span>11 // FINAL DIRECTIVE</span>
      </div>

      <h2 class="cta-headline">
        YOUR LIMITS ARE NOT FIXED.<br />
        <span class="outline-text">STOP WAITING.</span><br />
        READY TO BE <span class="text-accent">FORGED?</span>
      </h2>

      <p class="cta-sub">
        Claim your unrestricted 3-Day Compound Trial Pass. No credit card required. Immediate digital keycard activation.
      </p>

      <!-- Instant Quick-Claim Bar -->
      <form class="instant-claim-form" id="finalCtaForm">
        <div class="claim-input-group">
          <input
            type="text"
            name="athleteName"
            placeholder="YOUR FULL NAME"
            class="claim-input"
            required
          />
          <input
            type="email"
            name="athleteEmail"
            placeholder="YOUR EMAIL ADDRESS"
            class="claim-input"
            required
          />
        </div>
        <button class="btn btn-primary btn-lg cut-corner-br" type="submit">
          <span>CLAIM 3-DAY PASS NOW</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </button>
      </form>

      <div class="cta-footer-meta">
        <span class="meta-item">✓ 24/7 BIOMETRIC ENTRY INCLUDED</span>
        <span class="meta-sep">•</span>
        <span class="meta-item">✓ 2 CADRE CLASSES INCLUDED</span>
        <span class="meta-sep">•</span>
        <span class="meta-item">✓ ZERO COMMITMENT TRAPS</span>
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta-section {
    position: relative;
    padding-top: clamp(6rem, 12vw, 11rem);
    padding-bottom: clamp(6rem, 12vw, 11rem);
    background-color: var(--bg-black);
    overflow: hidden;
  }

  .cta-backdrop-texture {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  .cta-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.3) grayscale(90%) brightness(0.25);
  }

  .cta-backdrop-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(8, 9, 11, 0.4) 0%, rgba(8, 9, 11, 0.95) 100%);
  }

  .cta-container {
    position: relative;
    z-index: 2;
  }

  .cta-inner-card {
    background: rgba(14, 15, 20, 0.92);
    backdrop-filter: blur(20px);
    border: 1px solid var(--border-strong);
    border-left: 4px solid var(--accent-primary);
    padding: clamp(2.5rem, 5vw, 4.5rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8);
  }

  .cta-headline {
    font-size: clamp(2.8rem, 6.5vw, 5.8rem);
    line-height: 0.92;
    letter-spacing: -0.01em;
    margin-bottom: 1.5rem;
  }

  .outline-text {
    -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.8);
    color: transparent;
  }

  .text-accent {
    color: var(--accent-primary);
  }

  .cta-sub {
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    color: var(--text-white);
    max-width: 55ch;
    margin-bottom: 2.5rem;
    line-height: 1.5;
  }

  /* Instant Claim Form */
  .instant-claim-form {
    display: flex;
    gap: 1rem;
    width: 100%;
    max-width: 800px;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .claim-input-group {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    flex: 1;
    min-width: 320px;
  }

  .claim-input {
    background-color: var(--bg-deep);
    border: 1px solid var(--border-medium);
    color: var(--text-white);
    padding: 1.15rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    outline: none;
    transition: border-color var(--transition-fast);
  }

  .claim-input:focus {
    border-color: var(--accent-primary);
  }

  .cta-footer-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    flex-wrap: wrap;
  }

  .meta-item {
    color: var(--text-white);
  }

  .meta-sep {
    color: var(--border-medium);
  }

  /* Responsive Media Queries */
  @media (max-width: 768px) {
    .claim-input-group {
      grid-template-columns: 1fr;
      min-width: 100%;
    }
    .instant-claim-form .btn {
      width: 100%;
    }
    .cta-footer-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.35rem;
    }
    .meta-sep {
      display: none;
    }
  }
</style>

<script>
  // Final CTA Fast Submission
  const finalCtaForm = document.getElementById('finalCtaForm');
  finalCtaForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const target = e.target as HTMLFormElement;
    const name = (target.elements.namedItem('athleteName') as HTMLInputElement)?.value;
    const email = (target.elements.namedItem('athleteEmail') as HTMLInputElement)?.value;

    const modal = document.getElementById('trialPassModal');
    const modalName = document.getElementById('passHolderName');
    const modalEmail = document.getElementById('passHolderEmail');
    const modalStep1 = document.getElementById('modalStepForm');
    const modalStepPass = document.getElementById('modalStepPass');

    if (modal && modalStep1 && modalStepPass) {
      if (modalName) modalName.textContent = (name || 'ATHLETE').toUpperCase();
      if (modalEmail) modalEmail.textContent = email || 'cadre@ironforge.com';

      modalStep1.style.display = 'none';
      modalStepPass.style.display = 'flex';
      modal.classList.add('active');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }
  });
</script>
