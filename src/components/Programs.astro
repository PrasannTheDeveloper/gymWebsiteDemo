---
// Programs.astro - Filterable Editorial Training Disciplines
---

<section class="section programs-section section-border-top" id="programs" aria-label="Training Programs">
  <div class="container">
    <!-- Header -->
    <div class="programs-header">
      <div>
        <div class="editorial-badge">
          <span>02 // DISCIPLINE MATRIX</span>
        </div>
        <h2 class="section-title-huge">
          TRAINING <span class="text-accent">PROGRAMS.</span>
        </h2>
        <p class="section-lead">
          Systematic, science-backed athletic training disciplines designed for maximum human force production and cardiovascular durability.
        </p>
      </div>

      <!-- Filter Tabs -->
      <div class="program-filter-bar" role="tablist" aria-label="Program categories">
        <button class="filter-tab active" data-filter="all" role="tab" aria-selected="true">ALL (06)</button>
        <button class="filter-tab" data-filter="strength" role="tab" aria-selected="false">STRENGTH & IRON</button>
        <button class="filter-tab" data-filter="hybrid" role="tab" aria-selected="false">HYBRID & HYROX</button>
        <button class="filter-tab" data-filter="combat" role="tab" aria-selected="false">COMBAT & BOXING</button>
        <button class="filter-tab" data-filter="recovery" role="tab" aria-selected="false">RECOVERY</button>
      </div>
    </div>

    <!-- Dynamic Program Cards Grid -->
    <div class="programs-grid" id="programsGrid">
      <!-- Program 01: Heavy Iron & Powerlifting -->
      <article class="program-card" data-category="strength">
        <div class="card-top">
          <span class="card-idx">01 // STRENGTH</span>
          <div class="intensity-meter" title="Intensity: 5/5">
            <span class="meter-bar active"></span>
            <span class="meter-bar active"></span>
            <span class="meter-bar active"></span>
            <span class="meter-bar active"></span>
            <span class="meter-bar active"></span>
          </div>
        </div>

        <div class="card-media">
          <img src="/images/facility_weights.jpg" alt="Powerlifting and Barbell Training" class="card-bg-img" loading="lazy" />
          <div class="card-media-overlay"></div>
          <span class="duration-badge">60 MIN • RPE 8-10</span>
        </div>

        <div class="card-body">
          <h3 class="program-name">HEAVY IRON & POWERLIFTING</h3>
          <p class="program-desc">
            Master the compound power trio: Squat, Bench Press, and Deadlift. Focuses on CNS adaptation, bar velocity, and absolute maximal strength.
          </p>

          <div class="card-specs">
            <div class="spec-row">
              <span class="spec-label">PRIMARY TARGET:</span>
              <span class="spec-val">Maximal Force & Neural Drive</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">COACH LEAD:</span>
              <span class="spec-val text-accent">Alex Carter (CSCS)</span>
            </div>
          </div>

          <div class="card-footer">
            <button class="btn btn-primary btn-sm cut-corner-br w-full open-trial-modal" data-program="Heavy Iron & Powerlifting">
              <span>RESERVE PASS</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>
          </div>
        </div>
      </article>

      <!-- Program 02: Functional Athletics & Hyrox -->
      <article class="program-card" data-category="hybrid">
        <div class="card-top">
          <span class="card-idx">02 // HYBRID</span>
          <div class="intensity-meter" title="Intensity: 5/5">
            <span class="meter-bar active"></span>
            <span class="meter-bar active"></span>
            <span class="meter-bar active"></span>
            <span class="meter-bar active"></span>
            <span class="meter-bar active"></span>
          </div>
        </div>

        <div class="card-media">
          <img src="/images/facility_turf.jpg" alt="Functional Turf and Sled Training" class="card-bg-img" loading="lazy" />
          <div class="card-media-overlay"></div>
          <span class="duration-badge">50 MIN • ZONE 4/5</span>
        </div>

        <div class="card-body">
          <h3 class="program-name">FUNCTIONAL ATHLETICS & HYROX</h3>
          <p class="program-desc">
            High-density functional stamina. Prowler sled pushes, 50kg sandbag carries, Ski-Erg intervals, and tactical obstacle mechanics.
          </p>

          <div class="card-specs">
            <div class="spec-row">
              <span class="spec-label">PRIMARY TARGET:</span>
              <span class="spec-val">Lactic Threshold & Work Capacity</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">COACH LEAD:</span>
              <span class="spec-val text-accent">Marcus Thorne</span>
            </div>
          </div>

          <div class="card-footer">
            <button class="btn btn-primary btn-sm cut-corner-br w-full open-trial-modal" data-program="Functional Athletics & Hyrox">
              <span>RESERVE PASS</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>
          </div>
        </div>
      </article>

      <!-- Program 03: Combat Striking & Boxing -->
      <article class="program-card" data-category="combat">
        <div class="card-top">
          <span class="card-idx">03 // COMBAT</span>
          <div class="intensity-meter" title="Intensity: 4/5">
            <span class="meter-bar active"></span>
            <span class="meter-bar active"></span>
            <span class="meter-bar active"></span>
            <span class="meter-bar active"></span>
            <span class="meter-bar"></span>
          </div>
        </div>

        <div class="card-media">
          <img src="/images/hero_athlete.jpg" alt="Boxing and Combat Striking" class="card-bg-img" loading="lazy" />
          <div class="card-media-overlay"></div>
          <span class="duration-badge">45 MIN • HIGH ANAEROBIC</span>
        </div>

        <div class="card-body">
          <h3 class="program-name">COMBAT STRIKING & BOXING</h3>
          <p class="program-desc">
            Authentic pugilistic conditioning. 10-round heavy bag intervals, defensive pivots, punch combinations, and core rotational power.
          </p>

          <div class="card-specs">
            <div class="spec-row">
              <span class="spec-label">PRIMARY TARGET:</span>
              <span class="spec-val">Rotational Power & Reaction Speed</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">COACH LEAD:</span>
              <span class="spec-val text-accent">Elena Rostova</span>
            </div>
          </div>

          <div class="card-footer">
            <button class="btn btn-primary btn-sm cut-corner-br w-full open-trial-modal" data-program="Combat Striking & Boxing">
              <span>RESERVE PASS</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>
          </div>
        </div>
      </article>

      <!-- Program 04: Olympic Barbell Mechanics -->
      <article class="program-card" data-category="strength">
        <div class="card-top">
          <span class="card-idx">04 // OLYMPIC</span>
          <div class="intensity-meter" title="Intensity: 4/5">
            <span class="meter-bar active"></span>
            <span class="meter-bar active"></span>
            <span class="meter-bar active"></span>
            <span class="meter-bar active"></span>
            <span class="meter-bar"></span>
          </div>
        </div>

        <div class="card-media">
          <img src="/images/facility_weights.jpg" alt="Olympic Weightlifting Platform" class="card-bg-img" loading="lazy" />
          <div class="card-media-overlay"></div>
          <span class="duration-badge">60 MIN • TECHNICAL</span>
        </div>

        <div class="card-body">
          <h3 class="program-name">OLYMPIC WEIGHTLIFTING</h3>
          <p class="program-desc">
            Snatch, Clean & Jerk kinematics. Video review, bar path velocity, triple extension power, and thoracic mobility drills.
          </p>

          <div class="card-specs">
            <div class="spec-row">
              <span class="spec-label">PRIMARY TARGET:</span>
              <span class="spec-val">Explosive Power & Coordination</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">COACH LEAD:</span>
              <span class="spec-val text-accent">Maya Vance (USAW-L2)</span>
            </div>
          </div>

          <div class="card-footer">
            <button class="btn btn-primary btn-sm cut-corner-br w-full open-trial-modal" data-program="Olympic Weightlifting">
              <span>RESERVE PASS</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>
          </div>
        </div>
      </article>

      <!-- Program 05: Metabolic Engine (HIIT) -->
      <article class="program-card" data-category="hybrid">
        <div class="card-top">
          <span class="card-idx">05 // METABOLIC</span>
          <div class="intensity-meter" title="Intensity: 5/5">
            <span class="meter-bar active"></span>
            <span class="meter-bar active"></span>
            <span class="meter-bar active"></span>
            <span class="meter-bar active"></span>
            <span class="meter-bar active"></span>
          </div>
        </div>

        <div class="card-media">
          <img src="/images/facility_turf.jpg" alt="Metabolic HIIT Conditioning" class="card-bg-img" loading="lazy" />
          <div class="card-media-overlay"></div>
          <span class="duration-badge">45 MIN • PEAK CALORIC</span>
        </div>

        <div class="card-body">
          <h3 class="program-name">METABOLIC ENGINE (HIIT)</h3>
          <p class="program-desc">
            Tabata-style assault bike sprints, kettlebell complexes, rowing intervals, and plyometrics tracked on live biometric heart displays.
          </p>

          <div class="card-specs">
            <div class="spec-row">
              <span class="spec-label">PRIMARY TARGET:</span>
              <span class="spec-val">VO2 Max & Mitochondrial Output</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">COACH LEAD:</span>
              <span class="spec-val text-accent">Marcus Thorne</span>
            </div>
          </div>

          <div class="card-footer">
            <button class="btn btn-primary btn-sm cut-corner-br w-full open-trial-modal" data-program="Metabolic Engine (HIIT)">
              <span>RESERVE PASS</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>
          </div>
        </div>
      </article>

      <!-- Program 06: Cryotherapy & Dynamic Mobility -->
      <article class="program-card" data-category="recovery">
        <div class="card-top">
          <span class="card-idx">06 // RECOVERY</span>
          <div class="intensity-meter" title="Intensity: 2/5">
            <span class="meter-bar active"></span>
            <span class="meter-bar active"></span>
            <span class="meter-bar"></span>
            <span class="meter-bar"></span>
            <span class="meter-bar"></span>
          </div>
        </div>

        <div class="card-media">
          <img src="/images/facility_recovery.jpg" alt="Cryotherapy and Sauna Recovery" class="card-bg-img" loading="lazy" />
          <div class="card-media-overlay"></div>
          <span class="duration-badge">45 MIN • PARASYMPATHETIC</span>
        </div>

        <div class="card-body">
          <h3 class="program-name">CRYO & DYNAMIC RECOVERY</h3>
          <p class="program-desc">
            Guided cold plunge immersion (38°F), cedar infrared sauna thermal therapy, myofascial flossing, and joint decompression protocols.
          </p>

          <div class="card-specs">
            <div class="spec-row">
              <span class="spec-label">PRIMARY TARGET:</span>
              <span class="spec-val">Tissue Repair & Inflammation Reset</span>
            </div>
            <div class="spec-row">
              <span class="spec-label">COACH LEAD:</span>
              <span class="spec-val text-accent">Maya Vance</span>
            </div>
          </div>

          <div class="card-footer">
            <button class="btn btn-primary btn-sm cut-corner-br w-full open-trial-modal" data-program="Cryo & Dynamic Recovery">
              <span>RESERVE PASS</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .programs-section {
    background-color: var(--bg-deep);
    position: relative;
  }

  .programs-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 2rem;
    margin-bottom: 3.5rem;
  }

  /* Filter Tabs */
  .program-filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    background: var(--bg-surface);
    padding: 0.35rem;
    border: 1px solid var(--border-subtle);
  }

  .filter-tab {
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    padding: 0.65rem 1.15rem;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .filter-tab:hover {
    color: var(--text-white);
  }

  .filter-tab.active {
    background-color: var(--accent-primary);
    color: var(--text-dark);
  }

  /* Grid */
  .programs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  /* Card */
  .program-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform var(--transition-normal), border-color var(--transition-normal), box-shadow var(--transition-normal);
  }

  .program-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-accent);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .card-idx {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--accent-primary);
    font-weight: 700;
  }

  .intensity-meter {
    display: flex;
    gap: 3px;
  }

  .meter-bar {
    width: 6px;
    height: 12px;
    background: rgba(255, 255, 255, 0.15);
  }

  .meter-bar.active {
    background: var(--accent-primary);
  }

  .card-media {
    position: relative;
    height: 200px;
    overflow: hidden;
    background-color: var(--bg-card);
  }

  .card-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.1) brightness(0.9);
    transition: transform 0.6s var(--ease-out-expo);
  }

  .program-card:hover .card-bg-img {
    transform: scale(1.06);
  }

  .card-media-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgba(20, 22, 29, 0.95) 100%);
  }

  .duration-badge {
    position: absolute;
    bottom: 0.75rem;
    left: 1rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--text-white);
    background: rgba(8, 9, 11, 0.85);
    backdrop-filter: blur(6px);
    border: 1px solid var(--border-medium);
    padding: 0.25rem 0.5rem;
    letter-spacing: 0.1em;
  }

  .card-body {
    padding: 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    justify-content: space-between;
  }

  .program-name {
    font-family: var(--font-display);
    font-size: 1.55rem;
    color: var(--text-white);
    letter-spacing: 0.03em;
    line-height: 1.05;
    margin-bottom: 0.75rem;
  }

  .program-desc {
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--text-body);
    margin-bottom: 1.5rem;
  }

  .card-specs {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.85rem 0;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 1.25rem;
  }

  .spec-row {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .spec-label {
    color: var(--text-muted);
  }

  .spec-val {
    font-weight: 600;
    color: var(--text-white);
  }

  .text-accent {
    color: var(--accent-primary);
  }

  .w-full {
    width: 100%;
  }

  /* Responsive Media Queries */
  @media (max-width: 1100px) {
    .programs-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 700px) {
    .programs-grid {
      grid-template-columns: 1fr;
    }
    .programs-header {
      flex-direction: column;
      align-items: flex-start;
    }
    .program-filter-bar {
      width: 100%;
    }
    .filter-tab {
      flex: 1;
      text-align: center;
      padding: 0.5rem;
    }
  }
</style>

<script>
  // Interactive Program Filter Tabs
  const filterTabs = document.querySelectorAll('.filter-tab');
  const programCards = document.querySelectorAll<HTMLElement>('.program-card');

  filterTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      filterTabs.forEach(t => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');

      const filter = tab.getAttribute('data-filter');

      programCards.forEach(card => {
        if (filter === 'all' || card.getAttribute('data-category') === filter) {
          card.style.display = 'flex';
          card.style.opacity = '1';
        } else {
          card.style.display = 'none';
          card.style.opacity = '0';
        }
      });
    });
  });
</script>
