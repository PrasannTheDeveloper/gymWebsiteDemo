---
// Footer.astro - Architectural Industrial Footer
---

<footer class="site-footer" id="footer" aria-label="Site Footer">
  <!-- Top Ticker / Clock Bar -->
  <div class="footer-topbar">
    <div class="container footer-topbar-inner">
      <div class="footer-clock">
        <span class="clock-label">COMPOUND LOCAL TIME (PST):</span>
        <span class="clock-display text-accent" id="footerLiveTime">--:--:-- PST</span>
      </div>
      <div class="footer-uptime">
        <span class="status-dot"></span>
        <span>SECTOR 04 BIOMETRIC SURVEILLANCE & ENTRY: <strong class="text-white">ONLINE</strong></span>
      </div>
    </div>
  </div>

  <!-- Main Footer Content -->
  <div class="container footer-main">
    <div class="footer-grid">
      <!-- Brand & Mission Column -->
      <div class="footer-col brand-col">
        <a href="#hero" class="footer-logo">
          <div class="brand-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M4 4H20V8L14 14V20H10V14L4 8V4Z" stroke="currentColor" stroke-width="2.5"/>
            </svg>
          </div>
          <span class="f-brand-title">IRON FORGE</span>
        </a>

        <p class="footer-mission">
          An uncompromising industrial athletic compound dedicated to biomechanical strength, raw conditioning, and periodized human transformation. Built under pressure.
        </p>

        <!-- Newsletter Subscription -->
        <div class="footer-newsletter">
          <span class="newsletter-title">THE WEEKLY CADRE INTEL (TRAINING & PROTOCOLS)</span>
          <form class="newsletter-form" id="newsletterForm">
            <input
              type="email"
              placeholder="ENTER ATHLETE EMAIL"
              class="newsletter-input"
              required
            />
            <button class="newsletter-btn" type="submit" aria-label="Subscribe to intel">
              <span>JOIN INTEL</span>
            </button>
          </form>
        </div>
      </div>

      <!-- Links Column 1: Disciplines -->
      <div class="footer-col">
        <h4 class="footer-col-title">DISCIPLINES</h4>
        <ul class="footer-links">
          <li><a href="#programs">Heavy Iron & Powerlifting</a></li>
          <li><a href="#programs">Functional Athletics & Hyrox</a></li>
          <li><a href="#programs">Combat Striking & Boxing</a></li>
          <li><a href="#programs">Olympic Barbell Mechanics</a></li>
          <li><a href="#programs">Metabolic Engine (HIIT)</a></li>
          <li><a href="#programs">Cryo & Dynamic Recovery</a></li>
        </ul>
      </div>

      <!-- Links Column 2: Compound & Intel -->
      <div class="footer-col">
        <h4 class="footer-col-title">COMPOUND & INTEL</h4>
        <ul class="footer-links">
          <li><a href="#philosophy">The Forge Manifesto</a></li>
          <li><a href="#facility">45,000 SQ FT Zones</a></li>
          <li><a href="#coaches">Master Coaching Staff</a></li>
          <li><a href="#schedule">Live Weekly Timetable</a></li>
          <li><a href="#transformations">Verified Athlete Data</a></li>
          <li><a href="#calculator">90-Day Trajectory Calc</a></li>
        </ul>
      </div>

      <!-- Links Column 3: Access & Logistics -->
      <div class="footer-col">
        <h4 class="footer-col-title">ACCESS & CONTACT</h4>
        <ul class="footer-links">
          <li><a href="#membership">Membership Architecture</a></li>
          <li><a href="#location">742 Foundry Blvd (S.F.)</a></li>
          <li><a href="tel:+14158904766">(415) 890-IRON</a></li>
          <li><a href="mailto:cadre@ironforgefitness.com">cadre@ironforgefitness.com</a></li>
          <li><a href="#faq">Athlete Knowledge Base</a></li>
          <li><a href="#final-cta" class="text-accent open-trial-modal">Claim 3-Day Pass</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Legal Bar -->
    <div class="footer-bottom">
      <div class="legal-left">
        <p>© 2026 IRON FORGE FITNESS LLC. ALL RIGHTS RESERVED.</p>
        <span class="legal-tag">ENGINEERED FOR RIGOR</span>
      </div>

      <div class="social-links">
        <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="social-link">INSTAGRAM</a>
        <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="social-link">YOUTUBE</a>
        <a href="https://spotify.com" target="_blank" rel="noopener noreferrer" class="social-link">SPOTIFY CADRE</a>
        <a href="https://strava.com" target="_blank" rel="noopener noreferrer" class="social-link">STRAVA CLUB</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--bg-deep);
    border-top: 1px solid var(--border-medium);
    position: relative;
  }

  /* Topbar */
  .footer-topbar {
    background-color: var(--bg-surface);
    border-bottom: 1px solid var(--border-subtle);
    padding: 0.75rem 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .footer-topbar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-clock {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer-uptime {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Main Footer */
  .footer-main {
    padding-top: 4.5rem;
    padding-bottom: 3rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 3rem;
    margin-bottom: 4rem;
  }

  .brand-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .brand-icon {
    width: 32px;
    height: 32px;
    background-color: var(--accent-primary);
    color: var(--text-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 6px), calc(100% - 6px) 100%, 0 100%);
  }

  .f-brand-title {
    font-family: var(--font-display);
    font-size: 1.65rem;
    color: var(--text-white);
    letter-spacing: 0.04em;
  }

  .footer-mission {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--text-body);
    max-width: 38ch;
  }

  /* Newsletter */
  .footer-newsletter {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .newsletter-title {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    color: var(--text-white);
    font-weight: 700;
  }

  .newsletter-form {
    display: flex;
    background: var(--bg-surface);
    border: 1px solid var(--border-medium);
  }

  .newsletter-input {
    flex: 1;
    background: transparent;
    border: none;
    padding: 0.65rem 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-white);
    outline: none;
  }

  .newsletter-btn {
    background: var(--accent-primary);
    color: var(--text-dark);
    border: none;
    font-family: var(--font-display);
    font-size: 0.95rem;
    padding: 0.65rem 1rem;
    cursor: pointer;
    letter-spacing: 0.05em;
    font-weight: 700;
    transition: background-color var(--transition-fast);
  }

  .newsletter-btn:hover {
    background: var(--accent-hover);
  }

  /* Links Columns */
  .footer-col-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--text-white);
    letter-spacing: 0.08em;
    margin-bottom: 1.25rem;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-links a {
    font-size: 0.88rem;
    color: var(--text-body);
    transition: color var(--transition-fast), transform var(--transition-fast);
    display: inline-block;
  }

  .footer-links a:hover {
    color: var(--accent-primary);
    transform: translateX(3px);
  }

  /* Bottom Legal */
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .legal-left {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .legal-tag {
    color: var(--accent-primary);
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .social-link {
    color: var(--text-muted);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    transition: color var(--transition-fast);
  }

  .social-link:hover {
    color: var(--accent-primary);
  }

  .text-accent {
    color: var(--accent-primary);
  }

  .text-white {
    color: var(--text-white);
  }

  /* Responsive Breakpoints */
  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<script>
  // Live Pacific Time Clock in Footer
  function updateLiveClock() {
    const clockEl = document.getElementById('footerLiveTime');
    if (!clockEl) return;
    const now = new Date();
    const options: Intl.DateTimeFormatOptions = {
      timeZone: 'America/Los_Angeles',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false
    };
    clockEl.textContent = `${now.toLocaleTimeString('en-US', options)} PST`;
  }
  setInterval(updateLiveClock, 1000);
  updateLiveClock();

  // Newsletter Submission
  const newsletterForm = document.getElementById('newsletterForm');
  newsletterForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const target = e.target as HTMLFormElement;
    const toast = document.getElementById('globalToast');
    const toastMsg = document.getElementById('toastMessage');
    if (toast && toastMsg) {
      toastMsg.textContent = 'Enrolled into Iron Forge Weekly Intel successfully!';
      toast.classList.add('active');
      setTimeout(() => toast.classList.remove('active'), 5000);
    }
    target.reset();
  });
</script>
