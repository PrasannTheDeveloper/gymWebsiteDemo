</section>

<style>
  .schedule-section {
    background-color: var(--bg-black);
    position: relative;
  }

  .schedule-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  /* Time Filter Pills */
  .time-filter-pills {
    display: flex;
    gap: 0.5rem;
    background-color: var(--bg-surface);
    padding: 0.35rem;
    border: 1px solid var(--border-subtle);
  }

  .time-pill {
    background: transparent;
    border: none;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-muted);
    padding: 0.5rem 0.85rem;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .time-pill:hover {
    color: var(--text-white);
  }

  .time-pill.active {
    background-color: var(--bg-elevated);
    color: var(--accent-primary);
    border: 1px solid var(--accent-border);
  }

  /* Day Tabs Bar */
  .day-tabs-bar {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .day-tab {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 1rem 0.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    cursor: pointer;
    transition: all var(--transition-normal);
  }

  .day-tab:hover {
    background-color: var(--bg-card);
    border-color: var(--border-medium);
  }

  .day-tab.active {
    background-color: var(--bg-card);
    border-color: var(--accent-primary);
    box-shadow: 0 0 15px rgba(184, 255, 0, 0.15);
  }

  .day-code {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1;
    color: var(--text-white);
  }

  .day-tab.active .day-code {
    color: var(--accent-primary);
  }

  .day-full {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--text-muted);
    letter-spacing: 0.1em;
    margin-top: 0.25rem;
  }

  /* Schedule List Rows */
  .schedule-list-wrapper {
    display: flex;
    flex-direction: column;
  }

  .day-schedule-pane {
    display: none;
    flex-direction: column;
    gap: 0.75rem;
  }

  .day-schedule-pane.active {
    display: flex;
  }

  .schedule-row {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 1.25rem 1.5rem;
    display: grid;
    grid-template-columns: 100px 1.5fr 1fr 160px;
    align-items: center;
    gap: 1.5rem;
    transition: background-color var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast);
  }

  .schedule-row:hover {
    background-color: var(--bg-card);
    border-color: var(--border-medium);
    transform: translateX(4px);
  }

  .time-col {
    display: flex;
    flex-direction: column;
  }

  .time-main {
    font-family: var(--font-display);
    font-size: 1.85rem;
    line-height: 1;
    color: var(--text-white);
  }

  .time-sub {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-muted);
    letter-spacing: 0.1em;
    margin-top: 0.2rem;
  }

  .class-info-col {
    display: flex;
    flex-direction: column;
  }

  .class-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    margin-bottom: 0.25rem;
  }

  .class-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    letter-spacing: 0.03em;
    color: var(--text-white);
    line-height: 1.1;
    margin-bottom: 0.25rem;
  }

  .class-coach {
    font-size: 0.78rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .class-coach strong {
    color: var(--text-body);
  }

  .status-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
  }

  .spots-badge {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--accent-primary);
    background: var(--accent-dim);
    border: 1px solid var(--accent-border);
    padding: 0.25rem 0.6rem;
    letter-spacing: 0.08em;
  }

  .spots-badge.low {
    color: #ff5555;
    background: rgba(255, 85, 85, 0.12);
    border-color: rgba(255, 85, 85, 0.35);
  }

  .intensity-tag {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--text-muted);
    letter-spacing: 0.1em;
  }

  .action-col {
    display: flex;
    justify-content: flex-end;
  }

  /* Responsive Breakpoints */
  @media (max-width: 1024px) {
    .schedule-row {
      grid-template-columns: 80px 1fr auto;
      gap: 1rem;
    }
    .status-col {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .day-tabs-bar {
      grid-template-columns: repeat(4, 1fr);
    }
    .day-tab:nth-child(n+5) {
      grid-column: span 1;
    }
    .schedule-row {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .action-col {
      justify-content: stretch;
    }
    .action-col .btn {
      width: 100%;
    }
  }

  @media (max-width: 480px) {
    .day-tabs-bar {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

<script>
  // Day tab switcher
  const dayTabs = document.querySelectorAll('.day-tab');
  const dayPanes = document.querySelectorAll('.day-schedule-pane');

  dayTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      dayTabs.forEach(t => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');

      const targetDay = tab.getAttribute('data-day');
      dayPanes.forEach(pane => {
        if (pane.id === `pane-${targetDay}`) {
          pane.classList.add('active');
        } else {
          pane.classList.remove('active');
        }
      });
    });
  });

  // Time filter pills
  const timePills = document.querySelectorAll('.time-pill');
  timePills.forEach(pill => {
    pill.addEventListener('click', () => {
      timePills.forEach(p => p.classList.remove('active'));
      pill.classList.add('active');

      const filterTime = pill.getAttribute('data-time');
      const rows = document.querySelectorAll<HTMLElement>('.schedule-row');

      rows.forEach(row => {
        const period = row.getAttribute('data-period');
        if (filterTime === 'all' || period === filterTime) {
          row.style.display = 'grid';
        } else {
          row.style.display = 'none';
        }
      });
    });
