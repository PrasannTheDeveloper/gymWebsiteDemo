      <div class="day-schedule-pane" id="pane-sat">
        <div class="schedule-row" data-period="morning">
          <div class="time-col"><span class="time-main">08:00</span><span class="time-sub">75 MIN</span></div>
          <div class="class-info-col">
            <div class="class-meta"><span class="class-type text-accent">HYBRID CADRE</span><span class="class-location">ALL ZONES</span></div>
            <h3 class="class-title">SATURDAY MORNING FORGE CRUCIBLE (FULL COMPOUND)</h3>
            <p class="class-coach">COACHES: <strong>ALEX CARTER & MARCUS THORNE</strong></p>
          </div>
          <div class="status-col"><span class="spots-badge low">FULL / 2 ON WAITLIST</span><span class="intensity-tag">MAXIMAL</span></div>
          <div class="action-col"><button class="btn btn-secondary btn-sm cut-corner-br open-trial-modal" data-class="Forge Crucible (Sat 08:00)">JOIN WAITLIST</button></div>
        </div>
      </div>

      <div class="day-schedule-pane" id="pane-sun">
        <div class="schedule-row" data-period="morning">
          <div class="time-col"><span class="time-main">09:30</span><span class="time-sub">60 MIN</span></div>
          <div class="class-info-col">
            <div class="class-meta"><span class="class-type text-accent">RECOVERY & MOBILITY</span><span class="class-location">ZONE 03</span></div>
            <h3 class="class-title">SUNDAY DECOMPRESSION, COLD PLUNGE & BREATHWORK</h3>
            <p class="class-coach">COACH: <strong>MAYA VANCE</strong></p>
          </div>
          <div class="status-col"><span class="spots-badge">8 SPOTS LEFT</span><span class="intensity-tag">REGENERATION</span></div>
          <div class="action-col"><button class="btn btn-primary btn-sm cut-corner-br open-trial-modal" data-class="Sunday Decompression (Sun 09:30)">RESERVE SPOT</button></div>
        </div>
      </div>
    </div>
