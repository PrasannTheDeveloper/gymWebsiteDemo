---
// Schedule.astro - Interactive Weekly Live Class Schedule
---

<section class="section schedule-section section-border-top" id="schedule" aria-label="Class Schedule">
  <div class="container">
    <!-- Header -->
    <div class="schedule-header">
      <div>
        <div class="editorial-badge">
          <span>05 // LIVE TIMETABLE</span>
        </div>
        <h2 class="section-title-huge">
          CLASS <span class="text-accent">ROSTER.</span>
        </h2>
        <p class="section-lead">
          Small-cadre coach-led sessions capped at 12 athletes per block to ensure individual biomechanical form checks and high intensity.
        </p>
      </div>

      <!-- Time Filter Selector -->
      <div class="time-filter-pills" role="radiogroup" aria-label="Filter by time of day">
        <button class="time-pill active" data-time="all" type="button">ALL HOURS</button>
        <button class="time-pill" data-time="morning" type="button">MORNING (06:00-12:00)</button>
        <button class="time-pill" data-time="evening" type="button">EVENING (16:00-21:00)</button>
      </div>
    </div>

    <!-- Day of the Week Tab Bar -->
    <div class="day-tabs-bar" role="tablist" aria-label="Days of the week">
      <button class="day-tab active" data-day="mon" role="tab" aria-selected="true">
        <span class="day-code">MON</span>
        <span class="day-full">MONDAY</span>
      </button>
      <button class="day-tab" data-day="tue" role="tab" aria-selected="false">
        <span class="day-code">TUE</span>
        <span class="day-full">TUESDAY</span>
      </button>
      <button class="day-tab" data-day="wed" role="tab" aria-selected="false">
        <span class="day-code">WED</span>
        <span class="day-full">WEDNESDAY</span>
      </button>
      <button class="day-tab" data-day="thu" role="tab" aria-selected="false">
        <span class="day-code">THU</span>
        <span class="day-full">THURSDAY</span>
      </button>
      <button class="day-tab" data-day="fri" role="tab" aria-selected="false">
        <span class="day-code">FRI</span>
        <span class="day-full">FRIDAY</span>
      </button>
      <button class="day-tab" data-day="sat" role="tab" aria-selected="false">
        <span class="day-code">SAT</span>
        <span class="day-full">SATURDAY</span>
      </button>
      <button class="day-tab" data-day="sun" role="tab" aria-selected="false">
        <span class="day-code">SUN</span>
        <span class="day-full">SUNDAY</span>
      </button>
    </div>

    <!-- Schedule List Table -->
    <div class="schedule-list-wrapper" id="scheduleRoster">
      <!-- Monday Sessions (Default) -->
      <div class="day-schedule-pane active" id="pane-mon">
        <!-- Session 1 -->
        <div class="schedule-row" data-period="morning">
          <div class="time-col">
            <span class="time-main">06:00</span>
            <span class="time-sub">60 MIN</span>
          </div>
          <div class="class-info-col">
            <div class="class-meta">
              <span class="class-type text-accent">STRENGTH FOUNDRY</span>
              <span class="class-location">ZONE 01 // POWER RACKS</span>
            </div>
            <h3 class="class-title">HEAVY IRON: SQUAT & CNS OVERLOAD</h3>
            <p class="class-coach">COACH: <strong>ALEX CARTER (CSCS)</strong></p>
          </div>
          <div class="status-col">
            <span class="spots-badge low">3 SPOTS LEFT</span>
            <span class="intensity-tag">RPE 9-10</span>
          </div>
          <div class="action-col">
            <button class="btn btn-primary btn-sm cut-corner-br open-trial-modal" data-class="Heavy Iron: Squat & CNS Overload (Mon 06:00)">
              RESERVE SPOT
            </button>
          </div>
        </div>

        <!-- Session 2 -->
        <div class="schedule-row" data-period="morning">
          <div class="time-col">
            <span class="time-main">08:00</span>
            <span class="time-sub">50 MIN</span>
          </div>
          <div class="class-info-col">
            <div class="class-meta">
              <span class="class-type text-accent">HYBRID ENDURANCE</span>
              <span class="class-location">ZONE 02 // 60M TURF</span>
            </div>
            <h3 class="class-title">HYROX RACE ENGINE & PROWLER WORK</h3>
            <p class="class-coach">COACH: <strong>MARCUS THORNE</strong></p>
          </div>
          <div class="status-col">
            <span class="spots-badge">6 SPOTS LEFT</span>
            <span class="intensity-tag">ZONE 4/5</span>
          </div>
          <div class="action-col">
            <button class="btn btn-primary btn-sm cut-corner-br open-trial-modal" data-class="Hyrox Race Engine & Prowler Work (Mon 08:00)">
              RESERVE SPOT
            </button>
          </div>
        </div>

        <!-- Session 3 -->
        <div class="schedule-row" data-period="morning">
          <div class="time-col">
            <span class="time-main">10:30</span>
            <span class="time-sub">60 MIN</span>
          </div>
          <div class="class-info-col">
            <div class="class-meta">
              <span class="class-type text-accent">OLYMPIC RIGOR</span>
              <span class="class-location">ZONE 01 // PLATFORMS</span>
            </div>
            <h3 class="class-title">SNATCH KINEMATICS & OVERHEAD STABILITY</h3>
            <p class="class-coach">COACH: <strong>MAYA VANCE (USAW)</strong></p>
          </div>
          <div class="status-col">
            <span class="spots-badge">4 SPOTS LEFT</span>
            <span class="intensity-tag">TECHNICAL</span>
          </div>
          <div class="action-col">
            <button class="btn btn-primary btn-sm cut-corner-br open-trial-modal" data-class="Snatch Kinematics (Mon 10:30)">
              RESERVE SPOT
            </button>
          </div>
        </div>

        <!-- Session 4 -->
        <div class="schedule-row" data-period="evening">
          <div class="time-col">
            <span class="time-main">17:30</span>
            <span class="time-sub">45 MIN</span>
          </div>
          <div class="class-info-col">
            <div class="class-meta">
              <span class="class-type text-accent">PUGILISTIC COMBAT</span>
              <span class="class-location">ZONE 04 // COMBAT ARENA</span>
            </div>
            <h3 class="class-title">BOXING POWER & 10-ROUND HEAVY BAG</h3>
            <p class="class-coach">COACH: <strong>ELENA ROSTOVA</strong></p>
          </div>
          <div class="status-col">
            <span class="spots-badge low">2 SPOTS LEFT</span>
            <span class="intensity-tag">ANAEROBIC</span>
          </div>
          <div class="action-col">
            <button class="btn btn-primary btn-sm cut-corner-br open-trial-modal" data-class="Boxing Power & Heavy Bag (Mon 17:30)">
              RESERVE SPOT
            </button>
          </div>
        </div>

        <!-- Session 5 -->
        <div class="schedule-row" data-period="evening">
          <div class="time-col">
            <span class="time-main">19:00</span>
            <span class="time-sub">60 MIN</span>
          </div>
          <div class="class-info-col">
            <div class="class-meta">
              <span class="class-type text-accent">STRENGTH FOUNDRY</span>
              <span class="class-location">ZONE 01 // POWER RACKS</span>
            </div>
            <h3 class="class-title">BENCH PRESS VELOCITY & UPPER HYPERTROPHY</h3>
            <p class="class-coach">COACH: <strong>ALEX CARTER</strong></p>
          </div>
          <div class="status-col">
            <span class="spots-badge">5 SPOTS LEFT</span>
            <span class="intensity-tag">RPE 8-9</span>
          </div>
          <div class="action-col">
            <button class="btn btn-primary btn-sm cut-corner-br open-trial-modal" data-class="Bench Press Velocity (Mon 19:00)">
              RESERVE SPOT
            </button>
          </div>
        </div>
      </div>

      <!-- Tuesday Schedule -->
      <div class="day-schedule-pane" id="pane-tue">
        <div class="schedule-row" data-period="morning">
          <div class="time-col">
            <span class="time-main">06:00</span>
            <span class="time-sub">50 MIN</span>
          </div>
          <div class="class-info-col">
            <div class="class-meta">
              <span class="class-type text-accent">METABOLIC ENGINE</span>
              <span class="class-location">ZONE 02 // TURF</span>
            </div>
            <h3 class="class-title">TABATA INFERNO & ASSAULT BIKE INTERVALS</h3>
            <p class="class-coach">COACH: <strong>MARCUS THORNE</strong></p>
          </div>
          <div class="status-col">
            <span class="spots-badge">5 SPOTS LEFT</span>
            <span class="intensity-tag">PEAK CALORIC</span>
          </div>
          <div class="action-col">
            <button class="btn btn-primary btn-sm cut-corner-br open-trial-modal" data-class="Tabata Inferno (Tue 06:00)">RESERVE SPOT</button>
          </div>
        </div>

        <div class="schedule-row" data-period="evening">
          <div class="time-col">
            <span class="time-main">18:00</span>
            <span class="time-sub">60 MIN</span>
          </div>
          <div class="class-info-col">
            <div class="class-meta">
              <span class="class-type text-accent">STRENGTH FOUNDRY</span>
              <span class="class-location">ZONE 01 // PLATFORMS</span>
            </div>
            <h3 class="class-title">DEADLIFT CLINIC & POSTERIOR CHAIN</h3>
            <p class="class-coach">COACH: <strong>ALEX CARTER</strong></p>
          </div>
          <div class="status-col">
            <span class="spots-badge low">1 SPOT LEFT</span>
            <span class="intensity-tag">RPE 9-10</span>
          </div>
          <div class="action-col">
            <button class="btn btn-primary btn-sm cut-corner-br open-trial-modal" data-class="Deadlift Clinic (Tue 18:00)">RESERVE SPOT</button>
          </div>
        </div>
      </div>

      <!-- Other days fallback template generated via JS -->
      <div class="day-schedule-pane" id="pane-wed">
        <div class="schedule-row" data-period="morning">
          <div class="time-col"><span class="time-main">07:00</span><span class="time-sub">60 MIN</span></div>
          <div class="class-info-col">
            <div class="class-meta"><span class="class-type text-accent">OLYMPIC RIGOR</span><span class="class-location">ZONE 01</span></div>
            <h3 class="class-title">CLEAN & JERK VELOCITY BLOCKS</h3>
            <p class="class-coach">COACH: <strong>MAYA VANCE</strong></p>
          </div>
          <div class="status-col"><span class="spots-badge">4 SPOTS LEFT</span><span class="intensity-tag">TECHNICAL</span></div>
          <div class="action-col"><button class="btn btn-primary btn-sm cut-corner-br open-trial-modal" data-class="Clean & Jerk (Wed 07:00)">RESERVE SPOT</button></div>
        </div>
        <div class="schedule-row" data-period="evening">
          <div class="time-col"><span class="time-main">18:30</span><span class="time-sub">45 MIN</span></div>
          <div class="class-info-col">
            <div class="class-meta"><span class="class-type text-accent">RECOVERY SUITE</span><span class="class-location">ZONE 03</span></div>
            <h3 class="class-title">CRYO CONTRAST & DYNAMIC MOBILITY FLUSH</h3>
            <p class="class-coach">COACH: <strong>MAYA VANCE</strong></p>
          </div>
          <div class="status-col"><span class="spots-badge">7 SPOTS LEFT</span><span class="intensity-tag">RECOVERY</span></div>
          <div class="action-col"><button class="btn btn-primary btn-sm cut-corner-br open-trial-modal" data-class="Cryo Contrast (Wed 18:30)">RESERVE SPOT</button></div>
        </div>
      </div>

      <div class="day-schedule-pane" id="pane-thu">
        <div class="schedule-row" data-period="morning">
          <div class="time-col"><span class="time-main">06:30</span><span class="time-sub">50 MIN</span></div>
          <div class="class-info-col">
            <div class="class-meta"><span class="class-type text-accent">HYBRID</span><span class="class-location">ZONE 02</span></div>
            <h3 class="class-title">TACTICAL KETTLEBELL & SANDBAG COMPLEX</h3>
            <p class="class-coach">COACH: <strong>MARCUS THORNE</strong></p>
          </div>
          <div class="status-col"><span class="spots-badge">3 SPOTS LEFT</span><span class="intensity-tag">HIGH DENSITY</span></div>
          <div class="action-col"><button class="btn btn-primary btn-sm cut-corner-br open-trial-modal" data-class="Tactical Kettlebell (Thu 06:30)">RESERVE SPOT</button></div>
        </div>
      </div>

      <div class="day-schedule-pane" id="pane-fri">
        <div class="schedule-row" data-period="morning">
          <div class="time-col"><span class="time-main">06:00</span><span class="time-sub">60 MIN</span></div>
          <div class="class-info-col">
            <div class="class-meta"><span class="class-type text-accent">STRENGTH</span><span class="class-location">ZONE 01</span></div>
            <h3 class="class-title">HEAVY IRON: OVERHEAD PRESS & UPPER CNS</h3>
            <p class="class-coach">COACH: <strong>ALEX CARTER</strong></p>
          </div>
          <div class="status-col"><span class="spots-badge">4 SPOTS LEFT</span><span class="intensity-tag">RPE 9</span></div>
          <div class="action-col"><button class="btn btn-primary btn-sm cut-corner-br open-trial-modal" data-class="Overhead Press (Fri 06:00)">RESERVE SPOT</button></div>
        </div>
        <div class="schedule-row" data-period="evening">
          <div class="time-col"><span class="time-main">17:00</span><span class="time-sub">50 MIN</span></div>
          <div class="class-info-col">
            <div class="class-meta"><span class="class-type text-accent">COMBAT</span><span class="class-location">ZONE 04</span></div>
            <h3 class="class-title">FRIDAY NIGHT FIGHT NIGHT: HEAVY SPARRING & BAGS</h3>
            <p class="class-coach">COACH: <strong>ELENA ROSTOVA</strong></p>
          </div>
          <div class="status-col"><span class="spots-badge low">2 SPOTS LEFT</span><span class="intensity-tag">PEAK INTENSITY</span></div>
          <div class="action-col"><button class="btn btn-primary btn-sm cut-corner-br open-trial-modal" data-class="Fight Night (Fri 17:00)">RESERVE SPOT</button></div>
        </div>
