---
// Trainers.astro - Elite Coaching Roster & Editorial Dossiers
---

<section class="section trainers-section section-border-top" id="coaches" aria-label="Elite Coaching Staff">
  <div class="container">
    <!-- Header -->
    <div class="trainers-header">
      <div>
        <div class="editorial-badge">
          <span>04 // MASTER CADRE</span>
        </div>
        <h2 class="section-title-huge">
          ELITE <span class="text-accent">COACHES.</span>
        </h2>
        <p class="section-lead">
          Our coaches do not count reps or blow whistles. They are certified sports biomechanists, national competitors, and tactical trainers with decades of proven performance.
        </p>
      </div>

      <div class="trainer-stat-stamp">
        <span class="stamp-num">100%</span>
        <span class="stamp-label">DEGREE & CSCS ACCREDITED</span>
      </div>
    </div>

    <!-- Editorial Coach Grid -->
    <div class="trainers-grid">
      <!-- Coach 01: Alex Carter -->
      <article class="trainer-card">
        <div class="trainer-photo-box">
          <img
            src="/images/coach_alex.jpg"
            alt="Alex Carter, Head Strength Director"
            class="trainer-photo"
            loading="lazy"
          />
          <div class="trainer-photo-gradient"></div>
          <span class="coach-tag-badge">DIRECTOR // CSCS</span>
        </div>

        <div class="trainer-info">
          <div class="trainer-meta">
            <span class="trainer-idx">01 //</span>
            <span class="trainer-exp">12 YRS EXPERIENCE</span>
          </div>

          <h3 class="trainer-name">ALEX CARTER</h3>
          <p class="trainer-title">HEAD STRENGTH & PERIODIZATION DIRECTOR</p>

          <p class="trainer-bio">
            Former competitive IPF powerlifter and strength consultant for collegiate athletes. Specializes in barbell kinematic velocity and max force output.
          </p>

          <div class="trainer-specialties">
            <span class="spec-tag">POWERLIFTING</span>
            <span class="spec-tag">CNS PERIODIZATION</span>
            <span class="spec-tag">BIOMECHANICS</span>
          </div>

          <div class="trainer-action">
            <button class="btn btn-outline-accent btn-sm w-full open-trial-modal" data-coach="Alex Carter">
              <span>BOOK 1-ON-1 ASSESSMENT</span>
            </button>
          </div>
        </div>
      </article>

      <!-- Coach 02: Maya Vance -->
      <article class="trainer-card">
        <div class="trainer-photo-box">
          <img
            src="/images/facility_turf.jpg"
            alt="Maya Vance, Olympic Weightlifting Specialist"
            class="trainer-photo"
            loading="lazy"
          />
          <div class="trainer-photo-gradient"></div>
          <span class="coach-tag-badge">USAW-L2 // MOBILITY</span>
        </div>

        <div class="trainer-info">
          <div class="trainer-meta">
            <span class="trainer-idx">02 //</span>
            <span class="trainer-exp">9 YRS EXPERIENCE</span>
          </div>

          <h3 class="trainer-name">MAYA VANCE</h3>
          <p class="trainer-title">OLYMPIC WEIGHTLIFTING & MOBILITY COACH</p>

          <p class="trainer-bio">
            National Olympic lifting competitor and joint mobility specialist. Guides lifters through precise snatch bar paths, overhead stability, and hip opening mechanics.
          </p>

          <div class="trainer-specialties">
            <span class="spec-tag">SNATCH / CLEAN & JERK</span>
            <span class="spec-tag">THORACIC MOBILITY</span>
            <span class="spec-tag">BAR SPEED</span>
          </div>

          <div class="trainer-action">
            <button class="btn btn-outline-accent btn-sm w-full open-trial-modal" data-coach="Maya Vance">
              <span>BOOK 1-ON-1 ASSESSMENT</span>
            </button>
          </div>
        </div>
      </article>

      <!-- Coach 03: Marcus Thorne -->
      <article class="trainer-card">
        <div class="trainer-photo-box">
          <img
            src="/images/facility_weights.jpg"
            alt="Marcus Thorne, Hybrid Conditioning Specialist"
            class="trainer-photo"
            loading="lazy"
          />
          <div class="trainer-photo-gradient"></div>
          <span class="coach-tag-badge">TACTICAL // HYROX</span>
        </div>

        <div class="trainer-info">
          <div class="trainer-meta">
            <span class="trainer-idx">03 //</span>
            <span class="trainer-exp">10 YRS EXPERIENCE</span>
          </div>

          <h3 class="trainer-name">MARCUS THORNE</h3>
          <p class="trainer-title">HYBRID CONDITIONING & HYROX MASTER</p>

          <p class="trainer-bio">
            Former tactical physical training instructor and elite-tier Hyrox athlete. Builds relentless cardiovascular engines and functional work capacity.
          </p>

          <div class="trainer-specialties">
            <span class="spec-tag">VO2 MAX ENGINE</span>
            <span class="spec-tag">LACTIC TOLERANCE</span>
            <span class="spec-tag">PROWLER MECHANICS</span>
          </div>

          <div class="trainer-action">
            <button class="btn btn-outline-accent btn-sm w-full open-trial-modal" data-coach="Marcus Thorne">
              <span>BOOK 1-ON-1 ASSESSMENT</span>
            </button>
          </div>
        </div>
      </article>

      <!-- Coach 04: Elena Rostova -->
      <article class="trainer-card">
        <div class="trainer-photo-box">
          <img
            src="/images/hero_athlete.jpg"
            alt="Elena Rostova, Combat and Boxing Coach"
            class="trainer-photo"
            loading="lazy"
          />
          <div class="trainer-photo-gradient"></div>
          <span class="coach-tag-badge">BOXING // STRIKING</span>
        </div>

        <div class="trainer-info">
          <div class="trainer-meta">
            <span class="trainer-idx">04 //</span>
            <span class="trainer-exp">8 YRS EXPERIENCE</span>
          </div>

          <h3 class="trainer-name">ELENA ROSTOVA</h3>
          <p class="trainer-title">COMBAT & PUGILISTIC STRIKING COACH</p>

          <p class="trainer-bio">
            Regional Golden Gloves boxing champion. Expert in rotational kinetic chains, explosive punch generation, reaction speed, and heavy bag conditioning.
          </p>

          <div class="trainer-specialties">
            <span class="spec-tag">BOXING KINEMATICS</span>
            <span class="spec-tag">ROTATIONAL POWER</span>
            <span class="spec-tag">ANAEROBIC AGILITY</span>
          </div>

          <div class="trainer-action">
            <button class="btn btn-outline-accent btn-sm w-full open-trial-modal" data-coach="Elena Rostova">
              <span>BOOK 1-ON-1 ASSESSMENT</span>
            </button>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .trainers-section {
    background-color: var(--bg-deep);
    position: relative;
  }

  .trainers-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 2rem;
    margin-bottom: 3.5rem;
  }

  .trainer-stat-stamp {
    background: var(--bg-surface);
    border: 1px solid var(--border-medium);
    padding: 1rem 1.5rem;
    display: flex;
    flex-direction: column;
  }

  .stamp-num {
    font-family: var(--font-display);
    font-size: 2.25rem;
    color: var(--accent-primary);
    line-height: 1;
  }

  .stamp-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-muted);
    letter-spacing: 0.1em;
    margin-top: 0.2rem;
  }

  /* Grid */
  .trainers-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .trainer-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-normal), border-color var(--transition-normal), box-shadow var(--transition-normal);
  }

  .trainer-card:hover {
    transform: translateY(-5px);
    border-color: var(--border-accent);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5);
  }

  .trainer-photo-box {
    position: relative;
    height: 320px;
    overflow: hidden;
    background-color: var(--bg-card);
  }

  .trainer-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: contrast(1.1) brightness(0.95);
    transition: transform 0.6s var(--ease-out-expo);
  }

  .trainer-card:hover .trainer-photo {
    transform: scale(1.05);
  }

  .trainer-photo-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 50%, rgba(20, 22, 29, 0.95) 100%);
  }

  .coach-tag-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: rgba(8, 9, 11, 0.85);
    backdrop-filter: blur(6px);
    border: 1px solid var(--border-medium);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    color: var(--accent-primary);
    padding: 0.25rem 0.6rem;
    letter-spacing: 0.1em;
  }

  .trainer-info {
    padding: 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    justify-content: space-between;
  }

  .trainer-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: 0.6rem;
  }

  .trainer-idx {
    color: var(--accent-primary);
    font-weight: 700;
  }

  .trainer-name {
    font-family: var(--font-display);
    font-size: 1.65rem;
    color: var(--text-white);
    letter-spacing: 0.04em;
    line-height: 1;
    margin-bottom: 0.35rem;
  }

  .trainer-title {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--accent-primary);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.85rem;
    line-height: 1.4;
  }

  .trainer-bio {
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--text-body);
    margin-bottom: 1.25rem;
  }

  .trainer-specialties {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 1.5rem;
  }

  .spec-tag {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    padding: 0.2rem 0.45rem;
    letter-spacing: 0.05em;
  }

  .trainer-action {
    margin-top: auto;
  }

  .w-full {
    width: 100%;
  }

  /* Responsive Media Queries */
  @media (max-width: 1200px) {
    .trainers-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .trainers-grid {
      grid-template-columns: 1fr;
    }
    .trainers-header {
      flex-direction: column;
      align-items: flex-start;
    }
    .trainer-photo-box {
      height: 300px;
    }
  }
</style>
