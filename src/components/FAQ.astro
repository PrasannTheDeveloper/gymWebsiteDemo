---
// FAQ.astro - Accordion-Driven Athlete Intelligence
---

<section class="section faq-section section-border-top" id="faq" aria-label="Frequently Asked Questions">
  <div class="container">
    <!-- Header -->
    <div class="faq-header">
      <div>
        <div class="editorial-badge">
          <span>10 // ATHLETE INTELLIGENCE</span>
        </div>
        <h2 class="section-title-huge">
          FREQUENTLY ASKED <span class="text-accent">QUESTIONS.</span>
        </h2>
        <p class="section-lead">
          Clear, straightforward answers about our compound operations, coaching protocols, and membership terms.
        </p>
      </div>

      <div class="faq-contact-card">
        <span class="f-sub">NEED CLARIFICATION?</span>
        <span class="f-phone text-accent">(415) 890-IRON</span>
        <span class="f-email">cadre@ironforgefitness.com</span>
      </div>
    </div>

    <!-- Accordion List -->
    <div class="faq-accordion-list" id="faqAccordion">
      <!-- Item 1 -->
      <div class="faq-item active">
        <button class="faq-trigger" aria-expanded="true">
          <span class="faq-num">01 //</span>
          <span class="faq-question">WHAT DOES THE 3-DAY FREE TRIAL PASS INCLUDE?</span>
          <span class="faq-icon">+</span>
        </button>
        <div class="faq-content">
          <p>
            The 3-Day Trial gives you unrestricted access to the entire 45,000 sq ft compound, including all 14 power cages, Olympic lifting platforms, and 60m turf. You can also join any 2 coach-led cadre classes (Heavy Iron, Hyrox, Olympic Lifting, Boxing) and experience our Cryo & Infrared Sauna Recovery Suite. Zero credit card is required to claim your pass.
          </p>
        </div>
      </div>

      <!-- Item 2 -->
      <div class="faq-item">
        <button class="faq-trigger" aria-expanded="false">
          <span class="faq-num">02 //</span>
          <span class="faq-question">DO BEGINNERS NEED PRIOR BARBELL OR POWERLIFTING EXPERIENCE?</span>
          <span class="faq-icon">+</span>
        </button>
        <div class="faq-content">
          <p>
            No prior experience is necessary, but an uncompromising commitment to learning proper biomechanics is required. Every new member receives a comprehensive 45-minute movement screen and barbell trajectory assessment from a lead coach to establish safe baseline technique before loading weight.
          </p>
        </div>
      </div>

      <!-- Item 3 -->
      <div class="faq-item">
        <button class="faq-trigger" aria-expanded="false">
          <span class="faq-num">03 //</span>
          <span class="faq-question">HOW DOES 24/7 BIOMETRIC KEYCARD ENTRY WORK?</span>
          <span class="faq-icon">+</span>
        </button>
        <div class="faq-content">
          <p>
            Our compound features high-security encrypted biometric facial recognition and RFID digital smartphone keycards. Active members can enter through the private athlete portal 24 hours a day, 365 days a year—including holidays. The compound is continuously monitored via high-resolution telemetry and emergency contact stations.
          </p>
        </div>
      </div>

      <!-- Item 4 -->
      <div class="faq-item">
        <button class="faq-trigger" aria-expanded="false">
          <span class="faq-num">04 //</span>
          <span class="faq-question">WHAT IS YOUR CANCELLATION AND MEMBERSHIP FREEZE POLICY?</span>
          <span class="faq-icon">+</span>
        </button>
        <div class="faq-content">
          <p>
            We despise deceptive gym contracts. All month-to-month memberships can be paused or canceled directly through the Iron Forge mobile app with a single click and 14 days notice before your next billing date. No certified letters, no in-person retention pitches, and zero penalty fees.
          </p>
        </div>
      </div>

      <!-- Item 5 -->
      <div class="faq-item">
        <button class="faq-trigger" aria-expanded="false">
          <span class="faq-num">05 //</span>
          <span class="faq-question">WHAT SPECIALTY BARS AND GYM EQUIPMENT DO YOU PROVIDE?</span>
          <span class="faq-icon">+</span>
        </button>
        <div class="faq-content">
          <p>
            We supply calibrated Eleiko and Rogue competition steel plates, Texas Power Bars, Kabuki Strength Trap Bars, Duffalo Bars, Safety Squat Bars (SSB), cambered bars, and competition bench presses. Gym chalk blocks, deadlift jacks, calibrated belts, and resistance bands are free and accessible across all zones.
          </p>
        </div>
      </div>

      <!-- Item 6 -->
      <div class="faq-item">
        <button class="faq-trigger" aria-expanded="false">
          <span class="faq-num">06 //</span>
          <span class="faq-question">HOW DO I ACCESS AND BOOK THE CRYO & INFRARED SAUNA SUITE?</span>
          <span class="faq-icon">+</span>
        </button>
        <div class="faq-content">
          <p>
            Iron Pro and Forge Elite members enjoy walk-in and reserve access to our thermal recovery suite daily from 06:00 to 23:00. You can book 30-minute private recovery blocks directly from your member dashboard or drop in post-workout for cold plunge immersion (38°F) and cedar infrared heat (180°F).
          </p>
        </div>
      </div>

      <!-- Item 7 -->
      <div class="faq-item">
        <button class="faq-trigger" aria-expanded="false">
          <span class="faq-num">07 //</span>
          <span class="faq-question">CAN I BRING GUESTS OR TRAINING PARTNERS?</span>
          <span class="faq-icon">+</span>
        </button>
        <div class="faq-content">
          <p>
            Iron Pro members receive 4 complimentary guest day-passes each month. Forge Elite members enjoy unlimited guest privileges. Guests must register their ID at the front kiosk or via the digital pass link before training.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .faq-section {
    background-color: var(--bg-black);
    position: relative;
  }

  .faq-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 2rem;
    margin-bottom: 3.5rem;
  }

  .faq-contact-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-medium);
    padding: 1rem 1.5rem;
    display: flex;
    flex-direction: column;
    font-family: var(--font-mono);
  }

  .f-sub {
    font-size: 0.65rem;
    color: var(--text-muted);
    letter-spacing: 0.1em;
  }

  .f-phone {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0.2rem 0;
  }

  .f-email {
    font-size: 0.72rem;
    color: var(--text-body);
  }

  /* Accordion */
  .faq-accordion-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .faq-item {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .faq-item:hover {
    border-color: var(--border-medium);
  }

  .faq-item.active {
    background-color: var(--bg-deep);
    border-color: var(--border-accent);
  }

  .faq-trigger {
    width: 100%;
    background: transparent;
    border: none;
    padding: 1.5rem 1.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    cursor: pointer;
    text-align: left;
  }

  .faq-num {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent-primary);
    font-weight: 700;
    flex-shrink: 0;
  }

  .faq-question {
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--text-white);
    letter-spacing: 0.03em;
    flex: 1;
    line-height: 1.15;
  }

  .faq-icon {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    color: var(--accent-primary);
    line-height: 1;
    transition: transform var(--transition-normal);
  }

  .faq-item.active .faq-icon {
    transform: rotate(45deg);
  }

  .faq-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s var(--ease-out-expo), padding 0.35s var(--ease-out-expo);
    padding: 0 1.75rem;
  }

  .faq-item.active .faq-content {
    max-height: 250px;
    padding-bottom: 1.5rem;
  }

  .faq-content p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-body);
    border-top: 1px solid var(--border-subtle);
    padding-top: 1rem;
  }

  .text-accent {
    color: var(--accent-primary);
  }

  /* Responsive Breakpoints */
  @media (max-width: 640px) {
    .faq-header {
      flex-direction: column;
      align-items: flex-start;
    }
    .faq-trigger {
      padding: 1.25rem 1rem;
      gap: 0.75rem;
    }
    .faq-question {
      font-size: 1.1rem;
    }
    .faq-content {
      padding: 0 1rem;
    }
  }
</style>

<script>
  // Accordion Logic
  const faqItems = document.querySelectorAll('.faq-item');

  faqItems.forEach(item => {
    const trigger = item.querySelector('.faq-trigger');
    trigger?.addEventListener('click', () => {
      const isActive = item.classList.contains('active');

      faqItems.forEach(i => {
        i.classList.remove('active');
        i.querySelector('.faq-trigger')?.setAttribute('aria-expanded', 'false');
      });

      if (!isActive) {
        item.classList.add('active');
        trigger.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
